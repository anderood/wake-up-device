APP_PORT=3000
DB_STORAGE="wake-up-device.sqlite"
WOL_BROADCAST_ADDRESS="192.168.1.255"
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_SECURE=true
OIDC_ISSUER="https://issuer.example.com"
OIDC_CLIENT_ID="wake-up-device"
OIDC_CLIENT_SECRET="replace-with-client-secret"
OIDC_REDIRECT_URI="http://localhost:3000/auth/callback"
AWS_REGION_FILE="config/aws-ec2-regions.json"
WORKER_TIMEZONE="America/Sao_Paulo"
WORKER_MAX_RUNS_PER_TICK=10
WORKER_READ_RETRIES=2
