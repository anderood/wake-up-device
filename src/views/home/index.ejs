<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dispositivos</title>
  <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css">
  <style>
    :root {
      color-scheme: dark;
      --color-canvas: #0E1116;
      --color-surface: #171C24;
      --color-surface-elevated: #1D2530;
      --color-border: #28313C;
      --color-text-primary: #F3F1EA;
      --color-text-secondary: #9DA8B4;
      --color-text-tertiary: #6F7B87;
      --color-accent-primary: #F4B942;
      --color-accent-success: #6ED7A0;
      --color-accent-danger: #E47E7E;
      --font-sans: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
      --text-label: 11px;
      --text-caption: 12px;
      --text-body: 14px;
      --text-body-large: 16px;
      --text-title: 24px;
      --text-display: 48px;
      --font-weight-regular: 400;
      --font-weight-medium: 500;
      --font-weight-semibold: 600;
      --font-weight-bold: 700;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      font-family: var(--font-sans);
      background: var(--color-canvas);
      color: var(--color-text-primary);
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none !important;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--color-canvas);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    main {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: min(1120px, calc(100% - 48px));
      margin: 0 auto;
      padding: 56px 0;
    }

    .page-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }

    .page-heading {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-accent-primary);
      font-size: var(--text-label);
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.14em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.25rem, 5vw, var(--text-display));
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.05em;
      line-height: 1.05;
    }

    .primary-button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 13px 17px;
      border: 1px solid var(--color-accent-primary);
      border-radius: var(--radius-sm);
      background: var(--color-accent-primary);
      color: var(--color-canvas);
      font-size: var(--text-body);
      font-weight: var(--font-weight-bold);
      text-decoration: none;
      white-space: nowrap;
      transition: filter 160ms ease, transform 160ms ease;
    }

    .primary-button:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .primary-button:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
      outline-offset: 2px;
    }

    .search-form {
      display: flex;
      width: 100%;
    }

    .search-field {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
      height: 52px;
      padding: 0 16px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
      color: var(--color-text-secondary);
      transition: border-color 160ms ease;
    }

    .search-field:focus-within {
      border-color: var(--color-text-tertiary);
    }

    .search-field .fa-magnifying-glass {
      flex-shrink: 0;
      font-size: 1rem;
    }

    .search-input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: transparent;
      color: var(--color-text-primary);
      font: inherit;
      font-size: var(--text-body);
    }

    .search-input::placeholder {
      color: var(--color-text-secondary);
    }

    .search-input:focus {
      outline: none;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .device-count {
      margin: -16px 0 0;
      color: var(--color-text-tertiary);
      font-size: var(--text-caption);
      line-height: 1.4;
    }

    .flash {
      margin: 0;
      padding: 12px 16px;
      border: 1px solid color-mix(in srgb, var(--color-accent-success) 40%, transparent);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--color-accent-success) 12%, transparent);
      color: var(--color-accent-success);
      font-size: var(--text-body);
    }

    .device-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .empty-message {
      flex: 1 1 100%;
      margin: 0;
      padding: 40px 24px;
      border: 1px dashed var(--color-border);
      border-radius: var(--radius-lg);
      color: var(--color-text-tertiary);
      font-size: var(--text-body);
      text-align: center;
    }

    .device-card {
      display: flex;
      flex: 1 1 320px;
      flex-direction: column;
      gap: 20px;
      min-width: 320px;
      padding: 20px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .device-type {
      color: var(--color-text-tertiary);
      font-size: var(--text-label);
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .icon-button {
      display: inline-grid;
      place-items: center;
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--color-text-tertiary);
      font-size: 0.85rem;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .delete-button:hover {
      color: var(--color-accent-danger);
      border-color: color-mix(in srgb, var(--color-accent-danger) 50%, transparent);
    }

    .icon-button:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-accent-danger) 45%, transparent);
      outline-offset: 2px;
    }

    .card-identity {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .device-card h2 {
      margin: 0;
      color: var(--color-text-primary);
      font-size: var(--text-title);
      font-weight: var(--font-weight-semibold);
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .card-metadata {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .meta-label {
      flex-shrink: 0;
      width: 64px;
      color: var(--color-text-tertiary);
      font-size: var(--text-label);
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.1em;
      line-height: 1.2;
    }

    .meta-value {
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
      font-size: var(--text-body);
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .card-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: auto;
    }

    .card-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: var(--text-caption);
      font-weight: var(--font-weight-semibold);
      line-height: 1.3;
    }

    .card-status .status-dot {
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .card-status[data-tone="success"] {
      color: var(--color-accent-success);
    }

    .card-status[data-tone="muted"] {
      color: var(--color-text-tertiary);
    }

    .card-action-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .action-button {
      display: inline-grid;
      place-items: center;
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      text-decoration: none;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .action-button:hover {
      color: var(--color-text-primary);
      border-color: var(--color-text-tertiary);
      transform: translateY(-1px);
    }

    .action-button:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-text-secondary) 45%, transparent);
      outline-offset: 2px;
    }

    .wake-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      height: 36px;
      padding: 0 12px;
      border: 1px solid var(--color-accent-primary);
      border-radius: var(--radius-sm);
      background: var(--color-accent-primary);
      color: var(--color-canvas);
      font: inherit;
      font-size: var(--text-caption);
      font-weight: var(--font-weight-bold);
      cursor: pointer;
      transition: filter 160ms ease, transform 160ms ease;
    }

    .wake-button:hover:not(:disabled) {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .wake-button:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
      outline-offset: 2px;
    }

    .wake-button:disabled {
      cursor: wait;
      opacity: 0.75;
    }

    .wake-status {
      flex: 1 0 100%;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--text-caption);
      line-height: 1.45;
    }

    .wake-status[data-state="success"] {
      color: var(--color-accent-success);
    }

    .wake-status[data-state="warning"] {
      color: var(--color-accent-primary);
    }

    .wake-status[data-state="error"] {
      color: var(--color-accent-danger);
    }

    .delete-dialog {
      width: min(440px, calc(100% - 32px));
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      color: var(--color-text-primary);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    }

    .delete-dialog::backdrop {
      background: rgba(6, 8, 12, 0.78);
      backdrop-filter: blur(4px);
    }

    .delete-dialog-content {
      padding: 24px;
    }

    .delete-dialog h2 {
      margin: 0 0 10px;
      font-size: 1.5rem;
      letter-spacing: -0.02em;
    }

    .delete-dialog p {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--text-body);
      line-height: 1.6;
    }

    .delete-device-name {
      color: var(--color-text-primary);
    }

    .delete-error {
      margin-top: 16px !important;
      padding: 10px 12px;
      border: 1px solid color-mix(in srgb, var(--color-accent-danger) 45%, transparent);
      border-radius: var(--radius-sm);
      background: color-mix(in srgb, var(--color-accent-danger) 12%, transparent);
      color: var(--color-accent-danger) !important;
    }

    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }

    .dialog-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 16px;
      border-radius: var(--radius-sm);
      color: var(--color-text-primary);
      font: inherit;
      font-size: var(--text-body);
      font-weight: var(--font-weight-semibold);
      cursor: pointer;
    }

    .dialog-button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    .dialog-cancel {
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-text-secondary);
    }

    .dialog-confirm {
      border: 1px solid var(--color-accent-danger);
      background: var(--color-accent-danger);
      color: var(--color-canvas);
    }

    @media (max-width: 720px) {
      main {
        width: min(100% - 32px, 1120px);
        gap: 24px;
        padding: 32px 0;
      }

      .page-header {
        align-items: stretch;
        flex-direction: column;
        gap: 20px;
      }

      .primary-button {
        justify-content: center;
        width: 100%;
        height: 48px;
        padding: 0 16px;
      }

      .device-card {
        flex-basis: 100%;
        min-width: 0;
        gap: 16px;
        padding: 16px;
      }

      .dialog-actions {
        flex-direction: column-reverse;
      }

      .dialog-button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main>
    <header class="page-header">
      <div class="page-heading">
        <p class="eyebrow">Network control</p>
        <h1>Dispositivos</h1>
      </div>
      <a class="primary-button" href="/add/create">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        Adicionar dispositivo
      </a>
    </header>

    <form class="search-form" action="/" method="get" role="search">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input
          class="search-input"
          type="search"
          name="q"
          value="<%= searchTerm %>"
          placeholder="Buscar por nome ou tipo"
          aria-label="Buscar por nome ou tipo"
        >
        <button class="visually-hidden" type="submit">Buscar</button>
      </div>
    </form>

    <p class="device-count">
      <%= devices.length %> <%= devices.length === 1 ? "dispositivo cadastrado" : "dispositivos cadastrados" %>
    </p>

    <% if (created) { %>
      <p class="flash" role="status">Dispositivo cadastrado com sucesso.</p>
    <% } %>

    <% if (updated) { %>
      <p class="flash" role="status">Dispositivo atualizado com sucesso.</p>
    <% } %>

    <section class="device-grid" aria-label="Dispositivos cadastrados">
      <% if (devices.length === 0) { %>
        <p class="empty-message"><%= searchTerm ? "Nenhum dispositivo encontrado para a busca." : "Nenhum dispositivo cadastrado." %></p>
      <% } %>

      <% devices.forEach(device => {
        const hasMac = Boolean(device.mac_address);
        const hasLocal = Boolean(device.ip_address);
        const hasAccess = Boolean(device.local_access_url || device.external_access_url);
        let statusLabel = "Sem ações de acesso";
        let statusTone = "muted";

        if (hasMac && hasLocal) {
          statusLabel = "Pronto para ligar";
          statusTone = "success";
        } else if (hasMac) {
          statusLabel = "Sem acesso local";
        } else if (hasAccess) {
          statusLabel = "Acesso configurado";
          statusTone = "success";
        }
      %>
        <article class="device-card">
          <div class="card-top">
            <span class="device-type"><%= device.type || "Sem tipo" %></span>
            <button
              class="icon-button delete-button"
              type="button"
              data-device-id="<%= device.id %>"
              data-device-name="<%= device.name %>"
              aria-label="Excluir <%= device.name %>"
              title="Excluir dispositivo"
            ><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
          </div>

          <div class="card-identity">
            <h2><%= device.name %></h2>
          </div>

          <div class="card-metadata">
            <% if (device.mac_address) { %>
              <div class="meta-row">
                <span class="meta-label">MAC</span>
                <span class="meta-value"><%= device.mac_address %></span>
              </div>
            <% } %>
            <% if (device.ip_address) { %>
              <div class="meta-row">
                <span class="meta-label">LOCAL</span>
                <span class="meta-value"><%= device.ip_address %></span>
              </div>
            <% } %>
            <% if (device.external_ip_address) { %>
              <div class="meta-row">
                <span class="meta-label">EXTERNO</span>
                <span class="meta-value"><%= device.external_ip_address %></span>
              </div>
            <% } %>
            <% if (device.access_port) { %>
              <div class="meta-row">
                <span class="meta-label">PORTA</span>
                <span class="meta-value"><%= device.access_port %></span>
              </div>
            <% } %>
          </div>

          <div class="card-actions">
            <span class="card-status" data-tone="<%= statusTone %>">
              <span class="status-dot" aria-hidden="true"></span>
              <%= statusLabel %>
            </span>
            <div class="card-action-group">
              <% if (device.mac_address) { %>
                <button class="wake-button" type="button" data-device-id="<%= device.id %>" data-device-name="<%= device.name %>" aria-label="Ligar <%= device.name %>" title="Ligar <%= device.name %>">
                  <i class="action-icon fa-solid fa-power-off" aria-hidden="true"></i>
                  Ligar
                </button>
              <% } %>
              <% if (device.local_access_url) { %>
                <a class="action-button" href="<%= device.local_access_url %>" target="_blank" rel="noopener noreferrer" aria-label="Acessar <%= device.name %> pelo endereco local" title="Acessar <%= device.name %> pelo endereco local">
                  <i class="fa-solid fa-house" aria-hidden="true"></i>
                </a>
              <% } %>
              <% if (device.external_access_url) { %>
                <a class="action-button" href="<%= device.external_access_url %>" target="_blank" rel="noopener noreferrer" aria-label="Acessar <%= device.name %> pelo endereco externo" title="Acessar <%= device.name %> pelo endereco externo">
                  <i class="fa-solid fa-globe" aria-hidden="true"></i>
                </a>
              <% } %>
              <a class="action-button" href="/device/<%= device.id %>/edit" aria-label="Editar <%= device.name %>" title="Editar <%= device.name %>">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              </a>
            </div>
            <% if (device.mac_address) { %>
              <p class="wake-status" role="status" aria-live="polite" hidden></p>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <dialog class="delete-dialog" id="deleteDialog" aria-labelledby="deleteDialogTitle" aria-describedby="deleteDialogDescription">
      <div class="delete-dialog-content">
        <h2 id="deleteDialogTitle">Excluir dispositivo</h2>
        <p id="deleteDialogDescription">
          Tem certeza de que deseja excluir <strong class="delete-device-name" id="deleteDeviceName"></strong>? Esta acao nao pode ser desfeita.
        </p>
        <p class="delete-error" id="deleteError" role="alert" hidden></p>
        <div class="dialog-actions">
          <button class="dialog-button dialog-cancel" id="cancelDelete" type="button">Cancelar</button>
          <button class="dialog-button dialog-confirm" id="confirmDelete" type="button">Excluir</button>
        </div>
      </div>
    </dialog>
  </main>
  <script>
    const deviceGrid = document.querySelector(".device-grid");
    const searchInput = document.querySelector(".search-input");
    const deleteDialog = document.querySelector("#deleteDialog");
    const deleteDeviceName = document.querySelector("#deleteDeviceName");
    const deleteError = document.querySelector("#deleteError");
    const cancelDeleteButton = document.querySelector("#cancelDelete");
    const confirmDeleteButton = document.querySelector("#confirmDelete");
    let selectedDeviceId = null;
    let selectedCard = null;

    async function responseError(response, fallbackMessage) {
      try {
        const result = await response.json();

        if (typeof result.error === "string") {
          return result.error;
        }
      } catch {
        // Keep the fallback message when the response is not JSON.
      }

      return fallbackMessage;
    }

    const wait = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

    async function waitUntilOnline(deviceId) {
      const deadline = Date.now() + 60_000;

      while (Date.now() < deadline) {
        const response = await fetch(`/device/${encodeURIComponent(deviceId)}/ping`, {
          method: "POST",
          headers: { Accept: "application/json" }
        });

        if (!response.ok) {
          throw new Error(await responseError(
            response,
            "Nao foi possivel verificar se o dispositivo esta online."
          ));
        }

        const result = await response.json();

        if (result.online === true) {
          return true;
        }

        await wait(2_000);
      }

      return false;
    }

    document.querySelectorAll(".wake-button").forEach((button) => {
      button.addEventListener("click", async () => {
        const deviceId = button.dataset.deviceId;
        const deviceName = button.dataset.deviceName || "o dispositivo";
        const status = button.parentElement.parentElement.querySelector(".wake-status");
        const icon = button.querySelector(".action-icon");

        if (!deviceId || !status || !icon) {
          return;
        }

        const defaultLabel = button.getAttribute("aria-label") || "Ligar dispositivo";
        const defaultTitle = button.title || "Ligar dispositivo";
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.setAttribute("aria-label", `Enviando pacote Wake-on-LAN para ${deviceName}`);
        button.title = `Enviando pacote Wake-on-LAN para ${deviceName}`;
        icon.classList.remove("fa-power-off");
        icon.classList.add("fa-spinner", "fa-spin");
        status.hidden = false;
        status.dataset.state = "";
        status.textContent = `Enviando pacote Wake-on-LAN para ${deviceName}...`;

        try {
          const response = await fetch(`/device/${encodeURIComponent(deviceId)}/wake`, {
            method: "POST",
            headers: { Accept: "application/json" }
          });

          if (!response.ok) {
            throw new Error(await responseError(
              response,
              "Nao foi possivel enviar o pacote Wake-on-LAN. Tente novamente."
            ));
          }

          const result = await response.json();

          if (result.canConfirm !== true) {
            status.dataset.state = "success";
            status.textContent = `Pacote enviado para ${deviceName}. Cadastre um IPv4 local para confirmar se o dispositivo ficou online.`;
            return;
          }

          button.setAttribute("aria-label", `Aguardando ${deviceName} responder`);
          button.title = `Aguardando ${deviceName} responder`;
          status.textContent = `Pacote enviado para ${deviceName}. Aguardando o dispositivo responder...`;

          if (await waitUntilOnline(deviceId)) {
            status.dataset.state = "success";
            status.textContent = `${deviceName} esta online.`;
          } else {
            status.dataset.state = "warning";
            status.textContent = `Pacote enviado para ${deviceName}, mas o dispositivo nao respondeu ao ping.`;
          }
        } catch (error) {
          status.dataset.state = "error";
          const errorMessage = error instanceof Error
            ? error.message
            : "Nao foi possivel acordar o dispositivo. Tente novamente.";
          status.textContent = `${deviceName}: ${errorMessage}`;
        } finally {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.setAttribute("aria-label", defaultLabel);
          button.title = defaultTitle;
          icon.classList.remove("fa-spinner", "fa-spin");
          icon.classList.add("fa-power-off");
        }
      });
    });

    document.querySelectorAll(".delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        selectedDeviceId = button.dataset.deviceId;
        selectedCard = button.closest(".device-card");
        deleteDeviceName.textContent = button.dataset.deviceName || "este dispositivo";
        deleteError.hidden = true;
        deleteDialog.showModal();
      });
    });

    cancelDeleteButton.addEventListener("click", () => deleteDialog.close());

    deleteDialog.addEventListener("cancel", (event) => {
      if (confirmDeleteButton.disabled) {
        event.preventDefault();
      }
    });

    deleteDialog.addEventListener("close", () => {
      selectedDeviceId = null;
      selectedCard = null;
      deleteError.hidden = true;
    });

    confirmDeleteButton.addEventListener("click", async () => {
      if (!selectedDeviceId || !selectedCard) {
        return;
      }

      const deviceId = selectedDeviceId;
      const card = selectedCard;
      confirmDeleteButton.disabled = true;
      cancelDeleteButton.disabled = true;
      confirmDeleteButton.textContent = "Excluindo...";
      deleteError.hidden = true;

      try {
        const response = await fetch(`/device/${encodeURIComponent(deviceId)}`, {
          method: "DELETE",
          headers: { Accept: "application/json" }
        });

        if (!response.ok) {
          throw new Error(await responseError(
            response,
            "Nao foi possivel excluir o dispositivo. Tente novamente."
          ));
        }

        card.remove();
        deleteDialog.close();

        if (!deviceGrid.querySelector(".device-card")) {
          const emptyMessage = document.createElement("p");
          emptyMessage.className = "empty-message";
          emptyMessage.textContent = searchInput && searchInput.value.trim()
            ? "Nenhum dispositivo encontrado para a busca."
            : "Nenhum dispositivo cadastrado.";
          deviceGrid.append(emptyMessage);
        }
      } catch (error) {
        deleteError.textContent = error instanceof Error
          ? error.message
          : "Nao foi possivel excluir o dispositivo. Tente novamente.";
        deleteError.hidden = false;
      } finally {
        confirmDeleteButton.disabled = false;
        cancelDeleteButton.disabled = false;
        confirmDeleteButton.textContent = "Excluir";
      }
    });
  </script>
</body>
</html>
