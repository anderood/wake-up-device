<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dispositivos</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #e5e7eb;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #0f172a 0%, #111827 55%, #1e293b 100%);
    }

    main {
      width: min(960px, calc(100% - 32px));
      margin: 0 auto;
      padding: 48px 0;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 32px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: -0.04em;
    }

    p {
      margin: 0;
      color: #94a3b8;
      font-size: 1rem;
    }

    .success-message {
      margin-bottom: 24px;
      padding: 12px 16px;
      border: 1px solid rgba(74, 222, 128, 0.4);
      border-radius: 12px;
      background: rgba(20, 83, 45, 0.35);
      color: #bbf7d0;
    }

    .empty-message {
      padding: 24px;
      border: 1px dashed rgba(148, 163, 184, 0.32);
      border-radius: 20px;
      text-align: center;
    }

    .primary-link,
    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border-radius: 12px;
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
    }

    .primary-link {
      background: #2563eb;
    }

    .secondary-link {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
    }

    .device-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .device-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px;
      min-height: 210px;
      padding: 22px;
      border: 1px solid rgba(148, 163, 184, 0.24);
      border-radius: 20px;
      background: rgba(15, 23, 42, 0.72);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

    .delete-button {
      position: absolute;
      top: 16px;
      right: 16px;
      display: inline-grid;
      place-items: center;
      width: 34px;
      height: 34px;
      padding: 0;
      border: 1px solid rgba(248, 113, 113, 0.35);
      border-radius: 10px;
      background: rgba(127, 29, 29, 0.28);
      color: #fecaca;
      font: inherit;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
    }

    .delete-button:hover {
      border-color: rgba(248, 113, 113, 0.7);
      background: rgba(153, 27, 27, 0.58);
    }

    .delete-button:focus-visible {
      outline: 3px solid rgba(248, 113, 113, 0.45);
      outline-offset: 2px;
    }

    .device-card h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .device-type {
      display: inline-flex;
      width: fit-content;
      margin-right: 40px;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .device-info {
      display: grid;
      gap: 8px;
      color: #cbd5e1;
      font-size: 0.95rem;
    }

    .device-info span {
      color: #94a3b8;
    }

    .wake-button {
      width: 100%;
      margin-top: auto;
      padding: 12px 16px;
      border: 0;
      border-radius: 12px;
      background: #2563eb;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      cursor: not-allowed;
      opacity: 0.7;
    }

    .device-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      background: #2563eb;
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
    }

    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: auto;
    }

    .card-actions .wake-button,
    .card-actions .device-action,
    .card-actions .secondary-link {
      width: 100%;
    }

    .delete-dialog {
      width: min(440px, calc(100% - 32px));
      padding: 0;
      border: 1px solid rgba(148, 163, 184, 0.3);
      border-radius: 20px;
      background: #111827;
      color: #e5e7eb;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    }

    .delete-dialog::backdrop {
      background: rgba(2, 6, 23, 0.78);
      backdrop-filter: blur(4px);
    }

    .delete-dialog-content {
      padding: 24px;
    }

    .delete-dialog h2 {
      margin: 0 0 10px;
      font-size: 1.5rem;
    }

    .delete-dialog p {
      line-height: 1.6;
    }

    .delete-device-name {
      color: #e5e7eb;
    }

    .delete-error {
      margin-top: 16px;
      padding: 10px 12px;
      border: 1px solid rgba(248, 113, 113, 0.45);
      border-radius: 10px;
      background: rgba(127, 29, 29, 0.35);
      color: #fecaca !important;
    }

    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }

    .dialog-button {
      padding: 11px 16px;
      border-radius: 10px;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .dialog-button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    .dialog-cancel {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
    }

    .dialog-confirm {
      border: 1px solid #dc2626;
      background: #dc2626;
    }

    @media (max-width: 560px) {
      main {
        width: min(100% - 24px, 960px);
        padding: 28px 0;
      }

      header {
        align-items: flex-start;
        flex-direction: column;
      }

      .primary-link {
        width: 100%;
      }

      .device-card {
        min-height: auto;
      }

      .dialog-actions {
        flex-direction: column-reverse;
      }

      .dialog-button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <div>
        <h1>Dispositivos</h1>
        <p>Gerencie os dispositivos cadastrados da sua rede interna.</p>
      </div>
      <a class="primary-link" href="/add/create">Adicionar dispositivo</a>
    </header>

    <% if (created) { %>
      <p class="success-message" role="status">Dispositivo cadastrado com sucesso.</p>
    <% } %>

    <section class="device-grid" aria-label="Dispositivos cadastrados">
      <% if (devices.length === 0) { %>
        <p class="empty-message">Nenhum dispositivo cadastrado.</p>
      <% } %>

      <% devices.forEach(device => { %>
        <article class="device-card">
          <button
            class="delete-button"
            type="button"
            data-device-id="<%= device.id %>"
            data-device-name="<%= device.name %>"
            aria-label="Excluir <%= device.name %>"
            title="Excluir dispositivo"
          ><span aria-hidden="true">&times;</span></button>
          <span class="device-type"><%= device.type || "Sem tipo" %></span>
          <div>
            <h2><%= device.name %></h2>
            <div class="device-info">
              <div><span>Local:</span> <%= device.location %></div>
              <div><span>MAC:</span> <%= device.mac_address %></div>
            </div>
          </div>
          <div class="card-actions">
            <a class="secondary-link" href="/device/<%= device.id %>/edit">Editar</a>
            <% if (device.external_url) { %>
              <a class="device-action" href="<%= device.external_url %>" target="_blank" rel="noopener noreferrer">Acessar</a>
            <% } else { %>
              <button class="wake-button" type="button" disabled title="A rota para ligar este dispositivo sera definida depois">Ligar</button>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <dialog class="delete-dialog" id="deleteDialog" aria-labelledby="deleteDialogTitle" aria-describedby="deleteDialogDescription">
      <div class="delete-dialog-content">
        <h2 id="deleteDialogTitle">Excluir dispositivo</h2>
        <p id="deleteDialogDescription">
          Tem certeza de que deseja excluir <strong class="delete-device-name" id="deleteDeviceName"></strong>? Esta acao nao pode ser desfeita.
        </p>
        <p class="delete-error" id="deleteError" role="alert" hidden></p>
        <div class="dialog-actions">
          <button class="dialog-button dialog-cancel" id="cancelDelete" type="button">Cancelar</button>
          <button class="dialog-button dialog-confirm" id="confirmDelete" type="button">Excluir</button>
        </div>
      </div>
    </dialog>
  </main>
  <script>
    const deviceGrid = document.querySelector(".device-grid");
    const deleteDialog = document.querySelector("#deleteDialog");
    const deleteDeviceName = document.querySelector("#deleteDeviceName");
    const deleteError = document.querySelector("#deleteError");
    const cancelDeleteButton = document.querySelector("#cancelDelete");
    const confirmDeleteButton = document.querySelector("#confirmDelete");
    let selectedDeviceId = null;
    let selectedCard = null;

    document.querySelectorAll(".delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        selectedDeviceId = button.dataset.deviceId;
        selectedCard = button.closest(".device-card");
        deleteDeviceName.textContent = button.dataset.deviceName || "este dispositivo";
        deleteError.hidden = true;
        deleteDialog.showModal();
      });
    });

    cancelDeleteButton.addEventListener("click", () => deleteDialog.close());

    deleteDialog.addEventListener("cancel", (event) => {
      if (confirmDeleteButton.disabled) {
        event.preventDefault();
      }
    });

    deleteDialog.addEventListener("close", () => {
      selectedDeviceId = null;
      selectedCard = null;
      deleteError.hidden = true;
    });

    confirmDeleteButton.addEventListener("click", async () => {
      if (!selectedDeviceId || !selectedCard) {
        return;
      }

      const deviceId = selectedDeviceId;
      const card = selectedCard;
      confirmDeleteButton.disabled = true;
      cancelDeleteButton.disabled = true;
      confirmDeleteButton.textContent = "Excluindo...";
      deleteError.hidden = true;

      try {
        const response = await fetch(`/device/${encodeURIComponent(deviceId)}`, {
          method: "DELETE",
          headers: { Accept: "application/json" }
        });

        if (!response.ok) {
          let message = "Nao foi possivel excluir o dispositivo. Tente novamente.";

          try {
            const result = await response.json();

            if (typeof result.error === "string") {
              message = result.error;
            }
          } catch {
            // Keep the fallback message when the response is not JSON.
          }

          throw new Error(message);
        }

        card.remove();
        deleteDialog.close();

        if (!deviceGrid.querySelector(".device-card")) {
          const emptyMessage = document.createElement("p");
          emptyMessage.className = "empty-message";
          emptyMessage.textContent = "Nenhum dispositivo cadastrado.";
          deviceGrid.append(emptyMessage);
        }
      } catch (error) {
        deleteError.textContent = error instanceof Error
          ? error.message
          : "Nao foi possivel excluir o dispositivo. Tente novamente.";
        deleteError.hidden = false;
      } finally {
        confirmDeleteButton.disabled = false;
        cancelDeleteButton.disabled = false;
        confirmDeleteButton.textContent = "Excluir";
      }
    });
  </script>
</body>
</html>
