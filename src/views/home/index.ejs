<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dispositivos</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #e5e7eb;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #0f172a 0%, #111827 55%, #1e293b 100%);
    }

    main {
      width: min(960px, calc(100% - 32px));
      margin: 0 auto;
      padding: 48px 0;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 32px;
    }

    .header-actions {
      display: flex;
      gap: 10px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: -0.04em;
    }

    p {
      margin: 0;
      color: #94a3b8;
      font-size: 1rem;
    }

    .success-message {
      margin-bottom: 24px;
      padding: 12px 16px;
      border: 1px solid rgba(74, 222, 128, 0.4);
      border-radius: 12px;
      background: rgba(20, 83, 45, 0.35);
      color: #bbf7d0;
    }

    .empty-message {
      padding: 24px;
      border: 1px dashed rgba(148, 163, 184, 0.32);
      border-radius: 20px;
      text-align: center;
    }

    .search-form {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
    }

    .search-input {
      flex: 1;
      min-width: 0;
      padding: 12px 16px;
      border: 1px solid rgba(148, 163, 184, 0.32);
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.7);
      color: #e5e7eb;
      font: inherit;
    }

    .search-input::placeholder {
      color: #94a3b8;
    }

    .search-input:focus-visible {
      outline: 3px solid rgba(37, 99, 235, 0.45);
      outline-offset: 2px;
    }

    .search-button {
      padding: 12px 16px;
      border: 0;
      border-radius: 12px;
      background: #2563eb;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .primary-link,
    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border-radius: 12px;
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
    }

    .primary-link {
      background: #2563eb;
    }

    .secondary-link {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
    }

    .device-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .device-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px;
      min-height: 210px;
      padding: 22px;
      border: 1px solid rgba(148, 163, 184, 0.24);
      border-radius: 20px;
      background: rgba(15, 23, 42, 0.72);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

    .delete-button {
      position: absolute;
      top: 16px;
      right: 16px;
      display: inline-grid;
      place-items: center;
      width: 34px;
      height: 34px;
      padding: 0;
      border: 1px solid rgba(248, 113, 113, 0.35);
      border-radius: 10px;
      background: rgba(127, 29, 29, 0.28);
      color: #fecaca;
      font: inherit;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
    }

    .delete-button:hover {
      border-color: rgba(248, 113, 113, 0.7);
      background: rgba(153, 27, 27, 0.58);
    }

    .delete-button:focus-visible {
      outline: 3px solid rgba(248, 113, 113, 0.45);
      outline-offset: 2px;
    }

    .device-card h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .device-type {
      display: inline-flex;
      width: fit-content;
      margin-right: 40px;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .device-info {
      display: grid;
      gap: 8px;
      color: #cbd5e1;
      font-size: 0.95rem;
    }

    .device-info span {
      color: #94a3b8;
    }

    .card-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
    }

    .card-icon-action,
    .wake-button {
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 12px;
      color: #ffffff;
      cursor: pointer;
      transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
    }

    .card-icon-action {
      text-decoration: none;
    }

    .card-icon-action svg,
    .wake-button svg {
      width: 22px;
      height: 22px;
    }

    .card-icon-action:hover,
    .wake-button:hover:not(:disabled) {
      transform: translateY(-2px);
    }

    .card-icon-action:focus-visible,
    .wake-button:focus-visible {
      outline: 3px solid rgba(147, 197, 253, 0.55);
      outline-offset: 2px;
    }

    .card-icon-action--edit {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
      color: #cbd5e1;
    }

    .card-icon-action--edit:hover {
      border-color: rgba(148, 163, 184, 0.6);
      background: rgba(51, 65, 85, 0.75);
    }

    .card-icon-action--local {
      border: 1px solid #2563eb;
      background: #2563eb;
    }

    .card-icon-action--local:hover {
      background: #1d4ed8;
    }

    .card-icon-action--external {
      border: 1px solid #7c3aed;
      background: #7c3aed;
    }

    .card-icon-action--external:hover {
      background: #6d28d9;
    }

    .wake-button {
      border: 1px solid #16a34a;
      background: #16a34a;
      font: inherit;
    }

    .wake-button:hover:not(:disabled) {
      background: #15803d;
    }

    .wake-button:disabled {
      cursor: wait;
      opacity: 0.75;
    }

    .wake-button:disabled svg {
      animation: power-pulse 900ms ease-in-out infinite alternate;
    }

    @keyframes power-pulse {
      to {
        opacity: 0.35;
        transform: scale(0.82);
      }
    }

    .wake-status {
      flex: 1 0 100%;
      line-height: 1.45;
    }

    .wake-status[data-state="success"] {
      color: #86efac;
    }

    .wake-status[data-state="warning"] {
      color: #fde68a;
    }

    .wake-status[data-state="error"] {
      color: #fecaca;
    }

    .delete-dialog {
      width: min(440px, calc(100% - 32px));
      padding: 0;
      border: 1px solid rgba(148, 163, 184, 0.3);
      border-radius: 20px;
      background: #111827;
      color: #e5e7eb;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    }

    .delete-dialog::backdrop {
      background: rgba(2, 6, 23, 0.78);
      backdrop-filter: blur(4px);
    }

    .delete-dialog-content {
      padding: 24px;
    }

    .delete-dialog h2 {
      margin: 0 0 10px;
      font-size: 1.5rem;
    }

    .delete-dialog p {
      line-height: 1.6;
    }

    .delete-device-name {
      color: #e5e7eb;
    }

    .delete-error {
      margin-top: 16px;
      padding: 10px 12px;
      border: 1px solid rgba(248, 113, 113, 0.45);
      border-radius: 10px;
      background: rgba(127, 29, 29, 0.35);
      color: #fecaca !important;
    }

    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }

    .dialog-button {
      padding: 11px 16px;
      border-radius: 10px;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .dialog-button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    .dialog-cancel {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
    }

    .dialog-confirm {
      border: 1px solid #dc2626;
      background: #dc2626;
    }

    @media (max-width: 560px) {
      main {
        width: min(100% - 24px, 960px);
        padding: 28px 0;
      }

      header {
        align-items: flex-start;
        flex-direction: column;
      }

      .header-actions {
        flex-direction: column-reverse;
        width: 100%;
      }

      .header-actions a {
        width: 100%;
      }

      .search-form {
        flex-direction: column;
      }

      .search-button {
        width: 100%;
      }

      .device-card {
        min-height: auto;
      }

      .dialog-actions {
        flex-direction: column-reverse;
      }

      .dialog-button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <div>
        <h1>Dispositivos</h1>
        <p>Gerencie os dispositivos cadastrados da sua rede interna.</p>
      </div>
      <div class="header-actions">
        <a class="secondary-link" href="/settings">Configuracoes</a>
        <a class="primary-link" href="/add/create">Adicionar dispositivo</a>
      </div>
    </header>

    <form class="search-form" action="/" method="get" role="search">
      <input
        class="search-input"
        type="search"
        name="q"
        value="<%= searchTerm %>"
        placeholder="Buscar por nome, tipo ou local"
        aria-label="Buscar por nome, tipo ou local"
      >
      <button class="search-button" type="submit">Buscar</button>
    </form>

    <% if (created) { %>
      <p class="success-message" role="status">Dispositivo cadastrado com sucesso.</p>
    <% } %>

    <% if (updated) { %>
      <p class="success-message" role="status">Dispositivo atualizado com sucesso.</p>
    <% } %>

    <section class="device-grid" aria-label="Dispositivos cadastrados">
      <% if (devices.length === 0) { %>
        <p class="empty-message"><%= searchTerm ? "Nenhum dispositivo encontrado para a busca." : "Nenhum dispositivo cadastrado." %></p>
      <% } %>

      <% devices.forEach(device => { %>
        <article class="device-card">
          <button
            class="delete-button"
            type="button"
            data-device-id="<%= device.id %>"
            data-device-name="<%= device.name %>"
            aria-label="Excluir <%= device.name %>"
            title="Excluir dispositivo"
          ><span aria-hidden="true">&times;</span></button>
          <span class="device-type"><%= device.type || "Sem tipo" %></span>
          <div>
            <h2><%= device.name %></h2>
            <div class="device-info">
              <div><span>Local:</span> <%= device.location %></div>
              <% if (!device.local_url && device.mac_address) { %>
                <div><span>MAC:</span> <%= device.mac_address %></div>
              <% } %>
              <% if (device.ip_address) { %>
                <div><span>IPv4:</span> <%= device.ip_address %></div>
              <% } %>
            </div>
          </div>
          <div class="card-actions">
            <a class="card-icon-action card-icon-action--edit" href="/device/<%= device.id %>/edit" aria-label="Editar <%= device.name %>" title="Editar">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
              </svg>
            </a>
            <% if (device.local_url) { %>
              <a class="card-icon-action card-icon-action--local" href="<%= device.local_url %>" target="_blank" rel="noopener noreferrer" aria-label="Acessar <%= device.name %> pelo link local" title="Acessar link local">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h7.5"></path>
                </svg>
              </a>
              <% if (device.external_access_url) { %>
                <a class="card-icon-action card-icon-action--external" href="<%= device.external_access_url %>" target="_blank" rel="noopener noreferrer" aria-label="Acessar <%= device.name %> pelo link externo" title="Acessar link externo">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a9.004 9.004 0 0 1 8.716 6.747M12 3a9.004 9.004 0 0 0-8.716 6.747m17.432 0A17.933 17.933 0 0 1 12 12c-3.153 0-6.106-.815-8.716-2.253m17.432 0a9.043 9.043 0 0 1 0 4.506m0 0A17.932 17.932 0 0 0 12 12c-3.153 0-6.106.815-8.716 2.253m0 0a9.043 9.043 0 0 1 0-4.506"></path>
                  </svg>
                </a>
              <% } %>
            <% } else { %>
              <button class="wake-button" type="button" data-device-id="<%= device.id %>" aria-label="Ligar <%= device.name %>" title="Ligar">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1 0 12.728 0M12 3v9"></path>
                </svg>
              </button>
              <p class="wake-status" role="status" aria-live="polite" hidden></p>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <dialog class="delete-dialog" id="deleteDialog" aria-labelledby="deleteDialogTitle" aria-describedby="deleteDialogDescription">
      <div class="delete-dialog-content">
        <h2 id="deleteDialogTitle">Excluir dispositivo</h2>
        <p id="deleteDialogDescription">
          Tem certeza de que deseja excluir <strong class="delete-device-name" id="deleteDeviceName"></strong>? Esta acao nao pode ser desfeita.
        </p>
        <p class="delete-error" id="deleteError" role="alert" hidden></p>
        <div class="dialog-actions">
          <button class="dialog-button dialog-cancel" id="cancelDelete" type="button">Cancelar</button>
          <button class="dialog-button dialog-confirm" id="confirmDelete" type="button">Excluir</button>
        </div>
      </div>
    </dialog>
  </main>
  <script>
    const deviceGrid = document.querySelector(".device-grid");
    const searchInput = document.querySelector(".search-input");
    const deleteDialog = document.querySelector("#deleteDialog");
    const deleteDeviceName = document.querySelector("#deleteDeviceName");
    const deleteError = document.querySelector("#deleteError");
    const cancelDeleteButton = document.querySelector("#cancelDelete");
    const confirmDeleteButton = document.querySelector("#confirmDelete");
    let selectedDeviceId = null;
    let selectedCard = null;

    async function responseError(response, fallbackMessage) {
      try {
        const result = await response.json();

        if (typeof result.error === "string") {
          return result.error;
        }
      } catch {
        // Keep the fallback message when the response is not JSON.
      }

      return fallbackMessage;
    }

    const wait = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

    async function waitUntilOnline(deviceId) {
      const deadline = Date.now() + 60_000;

      while (Date.now() < deadline) {
        const response = await fetch(`/device/${encodeURIComponent(deviceId)}/ping`, {
          method: "POST",
          headers: { Accept: "application/json" }
        });

        if (!response.ok) {
          throw new Error(await responseError(
            response,
            "Nao foi possivel verificar se o dispositivo esta online."
          ));
        }

        const result = await response.json();

        if (result.online === true) {
          return true;
        }

        await wait(2_000);
      }

      return false;
    }

    document.querySelectorAll(".wake-button").forEach((button) => {
      button.addEventListener("click", async () => {
        const deviceId = button.dataset.deviceId;
        const status = button.parentElement.querySelector(".wake-status");

        if (!deviceId || !status) {
          return;
        }

        const defaultLabel = button.getAttribute("aria-label") || "Ligar dispositivo";
        const defaultTitle = button.title || "Ligar";
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.setAttribute("aria-label", "Enviando pacote Wake-on-LAN");
        button.title = "Enviando...";
        status.hidden = false;
        status.dataset.state = "";
        status.textContent = "Enviando pacote Wake-on-LAN...";

        try {
          const response = await fetch(`/device/${encodeURIComponent(deviceId)}/wake`, {
            method: "POST",
            headers: { Accept: "application/json" }
          });

          if (!response.ok) {
            throw new Error(await responseError(
              response,
              "Nao foi possivel enviar o pacote Wake-on-LAN. Tente novamente."
            ));
          }

          const result = await response.json();

          if (result.canConfirm !== true) {
            status.dataset.state = "success";
            status.textContent = "Pacote enviado. Cadastre um IPv4 para confirmar se o dispositivo ficou online.";
            return;
          }

          button.setAttribute("aria-label", "Aguardando o dispositivo responder");
          button.title = "Aguardando...";
          status.textContent = "Pacote enviado. Aguardando o dispositivo responder...";

          if (await waitUntilOnline(deviceId)) {
            status.dataset.state = "success";
            status.textContent = "Dispositivo online.";
          } else {
            status.dataset.state = "warning";
            status.textContent = "Pacote enviado, mas o dispositivo nao respondeu ao ping.";
          }
        } catch (error) {
          status.dataset.state = "error";
          status.textContent = error instanceof Error
            ? error.message
            : "Nao foi possivel acordar o dispositivo. Tente novamente.";
        } finally {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.setAttribute("aria-label", defaultLabel);
          button.title = defaultTitle;
        }
      });
    });

    document.querySelectorAll(".delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        selectedDeviceId = button.dataset.deviceId;
        selectedCard = button.closest(".device-card");
        deleteDeviceName.textContent = button.dataset.deviceName || "este dispositivo";
        deleteError.hidden = true;
        deleteDialog.showModal();
      });
    });

    cancelDeleteButton.addEventListener("click", () => deleteDialog.close());

    deleteDialog.addEventListener("cancel", (event) => {
      if (confirmDeleteButton.disabled) {
        event.preventDefault();
      }
    });

    deleteDialog.addEventListener("close", () => {
      selectedDeviceId = null;
      selectedCard = null;
      deleteError.hidden = true;
    });

    confirmDeleteButton.addEventListener("click", async () => {
      if (!selectedDeviceId || !selectedCard) {
        return;
      }

      const deviceId = selectedDeviceId;
      const card = selectedCard;
      confirmDeleteButton.disabled = true;
      cancelDeleteButton.disabled = true;
      confirmDeleteButton.textContent = "Excluindo...";
      deleteError.hidden = true;

      try {
        const response = await fetch(`/device/${encodeURIComponent(deviceId)}`, {
          method: "DELETE",
          headers: { Accept: "application/json" }
        });

        if (!response.ok) {
          throw new Error(await responseError(
            response,
            "Nao foi possivel excluir o dispositivo. Tente novamente."
          ));
        }

        card.remove();
        deleteDialog.close();

        if (!deviceGrid.querySelector(".device-card")) {
          const emptyMessage = document.createElement("p");
          emptyMessage.className = "empty-message";
          emptyMessage.textContent = searchInput && searchInput.value.trim()
            ? "Nenhum dispositivo encontrado para a busca."
            : "Nenhum dispositivo cadastrado.";
          deviceGrid.append(emptyMessage);
        }
      } catch (error) {
        deleteError.textContent = error instanceof Error
          ? error.message
          : "Nao foi possivel excluir o dispositivo. Tente novamente.";
        deleteError.hidden = false;
      } finally {
        confirmDeleteButton.disabled = false;
        cancelDeleteButton.disabled = false;
        confirmDeleteButton.textContent = "Excluir";
      }
    });
  </script>
</body>
</html>
