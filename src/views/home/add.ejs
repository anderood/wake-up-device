<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Adicionar Dispositivo</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Arial, Helvetica, sans-serif;
      background: #0f172a;
      color: #e5e7eb;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #0f172a 0%, #111827 55%, #1e293b 100%);
    }

    main {
      width: min(720px, calc(100% - 32px));
      margin: 0 auto;
      padding: 48px 0;
    }

    header {
      margin-bottom: 28px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.25rem);
      letter-spacing: -0.04em;
    }

    p {
      margin: 0;
      color: #94a3b8;
    }

    .error {
      padding: 12px 14px;
      border: 1px solid rgba(248, 113, 113, 0.45);
      border-radius: 12px;
      background: rgba(127, 29, 29, 0.35);
      color: #fecaca;
    }

    form {
      display: grid;
      gap: 18px;
      padding: 24px;
      border: 1px solid rgba(148, 163, 184, 0.24);
      border-radius: 20px;
      background: rgba(15, 23, 42, 0.72);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

    label {
      display: grid;
      gap: 8px;
      color: #cbd5e1;
      font-weight: 700;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .checkbox-label input {
      width: auto;
      accent-color: #2563eb;
    }

    .field-group {
      display: grid;
      gap: 18px;
    }

    .field-group[hidden] {
      display: none;
    }

    input,
    select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid rgba(148, 163, 184, 0.32);
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.92);
      color: #e5e7eb;
      font: inherit;
    }

    .actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 8px;
    }

    button,
    a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border-radius: 12px;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      text-decoration: none;
    }

    button {
      border: 0;
      background: #2563eb;
      cursor: pointer;
    }

    a {
      border: 1px solid rgba(148, 163, 184, 0.32);
      background: rgba(15, 23, 42, 0.7);
    }

    @media (max-width: 560px) {
      main {
        width: min(100% - 24px, 720px);
        padding: 28px 0;
      }

      .actions {
        flex-direction: column-reverse;
      }

      button,
      a {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Adicionar Dispositivo</h1>
      <p>Cadastre um dispositivo da sua rede local.</p>
    </header>

    <form method="post" action="/add">
      <% if (error) { %>
        <p class="error" role="alert"><%= error %></p>
      <% } %>

      <label>
        Nome
        <input type="text" name="name" value="<%= values.name %>" maxlength="20" required autofocus>
      </label>

      <label>
        Tipo
        <input type="text" name="type" value="<%= values.type %>" maxlength="20" placeholder="Ex.: TV, computador ou console" required>
      </label>

      <label class="checkbox-label">
        <input id="enableWake" type="checkbox" name="enableWake" value="1" <%= values.enableWake ? "checked" : "" %>>
        Ligar dispositivo
      </label>

      <div id="wakeFields" class="field-group">
        <label>
          Endereco MAC (opcional)
          <input id="macAddress" type="text" name="macAddress" value="<%= values.macAddress %>" maxlength="17" pattern="([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}" placeholder="AA:BB:CC:DD:EE:FF">
        </label>
      </div>

      <label class="checkbox-label">
        <input id="enableAccess" type="checkbox" name="enableAccess" value="1" <%= values.enableAccess ? "checked" : "" %>>
        Porta de acesso
      </label>

      <div id="accessFields" class="field-group">
        <label>
          Endereco IPv4 local (opcional)
          <input id="localIpAddress" type="text" name="localIpAddress" value="<%= values.localIpAddress %>" maxlength="15" inputmode="decimal" pattern="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])" placeholder="192.168.1.6">
        </label>

        <label>
          Endereco IPv4 externo (opcional)
          <input id="externalIpAddress" type="text" name="externalIpAddress" value="<%= values.externalIpAddress %>" maxlength="15" inputmode="decimal" pattern="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])" placeholder="100.100.10.10">
        </label>

        <label>
          Porta de acesso (obrigatoria com IPv4)
          <input id="accessPort" type="number" name="accessPort" value="<%= values.accessPort %>" min="1" max="65535" inputmode="numeric" placeholder="8080">
        </label>
      </div>

      <div class="actions">
        <a href="/">Cancelar</a>
        <button type="submit">Cadastrar dispositivo</button>
      </div>
    </form>
  </main>
  <script>
    const enableWake = document.querySelector("#enableWake");
    const enableAccess = document.querySelector("#enableAccess");
    const wakeFields = document.querySelector("#wakeFields");
    const accessFields = document.querySelector("#accessFields");
    const localIpAddress = document.querySelector("#localIpAddress");
    const externalIpAddress = document.querySelector("#externalIpAddress");
    const accessPort = document.querySelector("#accessPort");

    function setGroupEnabled(group, enabled) {
      group.hidden = !enabled;
      group.querySelectorAll("input").forEach((input) => {
        input.disabled = !enabled;
      });
    }

    function updateAccessPortRequirement() {
      accessPort.required = enableAccess.checked && Boolean(localIpAddress.value.trim() || externalIpAddress.value.trim());
    }

    function updateWakeFields() {
      setGroupEnabled(wakeFields, enableWake.checked);
    }

    function updateAccessFields() {
      setGroupEnabled(accessFields, enableAccess.checked);
      updateAccessPortRequirement();
    }

    enableWake.addEventListener("change", updateWakeFields);
    enableAccess.addEventListener("change", updateAccessFields);
    localIpAddress.addEventListener("input", updateAccessPortRequirement);
    externalIpAddress.addEventListener("input", updateAccessPortRequirement);
    updateWakeFields();
    updateAccessFields();
  </script>
</body>
</html>
