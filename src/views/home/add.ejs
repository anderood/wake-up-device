<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Adicionar Dispositivo</title>
  <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css">
  <style>
    :root {
      color-scheme: dark;
      --color-canvas: #0E1116;
      --color-surface: #171C24;
      --color-surface-elevated: #1D2530;
      --color-border: #28313C;
      --color-text-primary: #F3F1EA;
      --color-text-secondary: #9DA8B4;
      --color-text-tertiary: #6F7B87;
      --color-accent-primary: #F4B942;
      --color-accent-success: #6ED7A0;
      --color-accent-danger: #E47E7E;
      --font-sans: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
      --text-label: 11px;
      --text-caption: 12px;
      --text-body: 14px;
      --text-body-large: 16px;
      --font-weight-regular: 400;
      --font-weight-medium: 500;
      --font-weight-semibold: 600;
      --font-weight-bold: 700;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      font-family: var(--font-sans);
      background: var(--color-canvas);
      color: var(--color-text-primary);
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none !important;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--color-canvas);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .page {
      display: flex;
      flex-direction: column;
      gap: 28px;
      width: min(816px, calc(100% - 48px));
      margin: 0 auto;
      padding: 56px 0;
    }

    .page-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
    }

    .page-heading {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.25rem, 5vw, 2.5rem);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.05em;
      line-height: 1.1;
    }

    .page-subtitle {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--text-body-large);
      line-height: 1.5;
    }

    .back-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 42px;
      padding: 0 14px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--color-text-secondary);
      font-size: var(--text-body);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
      white-space: nowrap;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .back-button:hover {
      color: var(--color-text-primary);
      border-color: var(--color-text-tertiary);
    }

    .back-button:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-text-secondary) 45%, transparent);
      outline-offset: 2px;
    }

    .form-error {
      margin: 0;
      padding: 12px 16px;
      border: 1px solid color-mix(in srgb, var(--color-accent-danger) 45%, transparent);
      border-radius: var(--radius-sm);
      background: color-mix(in srgb, var(--color-accent-danger) 12%, transparent);
      color: var(--color-accent-danger);
      font-size: var(--text-body);
    }

    .form-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }

    .form-section {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 24px 28px;
      border-bottom: 1px solid var(--color-border);
    }

    .form-section:last-of-type {
      border-bottom: 0;
    }

    .section-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .section-heading {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .section-title {
      margin: 0;
      color: var(--color-text-primary);
      font-size: var(--text-body-large);
      font-weight: var(--font-weight-semibold);
      line-height: 1.4;
    }

    .section-description {
      margin: 0;
      color: var(--color-text-tertiary);
      font-size: var(--text-caption);
      line-height: 1.5;
    }

    .toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      cursor: pointer;
    }

    .toggle-label {
      color: var(--color-text-secondary);
      font-size: var(--text-caption);
      font-weight: var(--font-weight-semibold);
      white-space: nowrap;
    }

    .toggle input {
      position: absolute;
      width: 0;
      height: 0;
      opacity: 0;
    }

    .toggle-track {
      position: relative;
      flex-shrink: 0;
      width: 44px;
      height: 26px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface-elevated);
      transition: background-color 160ms ease, border-color 160ms ease;
    }

    .toggle-track::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--color-text-tertiary);
      transition: transform 160ms ease, background-color 160ms ease;
    }

    .toggle input:checked + .toggle-track {
      border-color: var(--color-accent-primary);
      background: var(--color-accent-primary);
    }

    .toggle input:checked + .toggle-track::after {
      transform: translateX(18px);
      background: var(--color-canvas);
    }

    .toggle input:focus-visible + .toggle-track {
      outline: 3px solid color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
      outline-offset: 2px;
    }

    .field-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      width: 100%;
    }

    .field {
      display: flex;
      flex: 1 1 240px;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }

    .field--port {
      flex: 0 0 150px;
    }

    .field label {
      color: var(--color-text-secondary);
      font-size: var(--text-label);
      font-weight: var(--font-weight-semibold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .field input {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-canvas);
      color: var(--color-text-primary);
      font: inherit;
      font-size: var(--text-body);
      transition: border-color 160ms ease;
    }

    .field input.mono {
      font-family: var(--font-mono);
    }

    .field input::placeholder {
      color: var(--color-text-tertiary);
    }

    .field input:focus-visible {
      outline: none;
      border-color: var(--color-accent-primary);
    }

    .field input:disabled {
      opacity: 0.5;
    }

    .form-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      padding: 20px 28px;
    }

    .button-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 16px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--color-text-secondary);
      font-size: var(--text-body);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .button-secondary:hover {
      color: var(--color-text-primary);
      border-color: var(--color-text-tertiary);
    }

    .button-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      height: 44px;
      padding: 0 17px;
      border: 1px solid var(--color-accent-primary);
      border-radius: var(--radius-sm);
      background: var(--color-accent-primary);
      color: var(--color-canvas);
      font-size: var(--text-body);
      font-weight: var(--font-weight-bold);
      cursor: pointer;
      transition: filter 160ms ease, transform 160ms ease;
    }

    .button-primary:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .button-primary:focus-visible,
    .button-secondary:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
      outline-offset: 2px;
    }

    @media (max-width: 720px) {
      .page {
        width: min(100% - 32px, 816px);
        gap: 16px;
        padding: 24px 0;
      }

      .page-header {
        align-items: stretch;
        flex-direction: column;
        gap: 14px;
      }

      .back-button {
        width: 100%;
      }

      .form-section {
        gap: 16px;
        padding: 16px 14px;
      }

      .field-grid {
        flex-direction: column;
        gap: 12px;
      }

      .field {
        flex: 0 0 auto;
      }

      .field input {
        height: 44px;
      }

      .field--port {
        flex-basis: auto;
        width: 100%;
      }

      .form-actions {
        flex-direction: column-reverse;
        padding: 14px;
      }

      .button-primary,
      .button-secondary {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <header class="page-header">
      <div class="page-heading">
        <h1>Adicionar dispositivo</h1>
        <p class="page-subtitle">Cadastre um dispositivo da sua rede local.</p>
      </div>
      <a class="back-button" href="/">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Voltar
      </a>
    </header>

    <% if (error) { %>
      <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <form method="post" action="/add">
      <div class="form-card">
        <section class="form-section">
          <div class="section-header">
            <div class="section-heading">
              <h2 class="section-title">Identificação</h2>
              <p class="section-description">Como o dispositivo será reconhecido na sua rede.</p>
            </div>
          </div>
          <div class="field-grid">
            <div class="field">
              <label for="name">Nome</label>
              <input id="name" type="text" name="name" value="<%= values.name %>" maxlength="20" required autofocus>
            </div>
            <div class="field">
              <label for="type">Tipo</label>
              <input id="type" type="text" name="type" value="<%= values.type %>" maxlength="20" placeholder="Ex.: TV, computador ou console" required>
            </div>
          </div>
        </section>

        <section class="form-section">
          <div class="section-header">
            <div class="section-heading">
              <h2 class="section-title">Wake-on-LAN</h2>
              <p class="section-description">Envie um sinal para ligar o dispositivo remotamente.</p>
            </div>
            <label class="toggle">
              <span class="toggle-label">Ativado</span>
              <input id="enableWake" type="checkbox" name="enableWake" value="1" <%= values.enableWake ? "checked" : "" %>>
              <span class="toggle-track" aria-hidden="true"></span>
            </label>
          </div>
          <div class="field-grid">
            <div id="wakeFields" class="field">
              <label for="macAddress">Endereço MAC</label>
              <input id="macAddress" class="mono" type="text" name="macAddress" value="<%= values.macAddress %>" maxlength="17" pattern="([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}" placeholder="AA:BB:CC:DD:EE:FF">
            </div>
          </div>
        </section>

        <section class="form-section">
          <div class="section-header">
            <div class="section-heading">
              <h2 class="section-title">Acesso</h2>
              <p class="section-description">Defina os endereços usados para acessar o dispositivo.</p>
            </div>
            <label class="toggle">
              <span class="toggle-label">Porta configurada</span>
              <input id="enableAccess" type="checkbox" name="enableAccess" value="1" <%= values.enableAccess ? "checked" : "" %>>
              <span class="toggle-track" aria-hidden="true"></span>
            </label>
          </div>
          <div class="field-grid">
            <div class="field">
              <label for="localIpAddress">IPv4 local</label>
              <input id="localIpAddress" class="mono" type="text" name="localIpAddress" value="<%= values.localIpAddress %>" maxlength="15" inputmode="decimal" pattern="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])" placeholder="192.168.1.6">
            </div>
            <div class="field">
              <label for="externalIpAddress">IPv4 externo</label>
              <input id="externalIpAddress" class="mono" type="text" name="externalIpAddress" value="<%= values.externalIpAddress %>" maxlength="15" inputmode="decimal" pattern="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])" placeholder="100.100.10.10">
            </div>
            <div id="accessFields" class="field field--port">
              <label for="accessPort">Porta</label>
              <input id="accessPort" class="mono" type="number" name="accessPort" value="<%= values.accessPort %>" min="1" max="65535" inputmode="numeric" placeholder="8080">
            </div>
          </div>
        </section>

        <div class="form-actions">
          <a class="button-secondary" href="/">Cancelar</a>
          <button class="button-primary" type="submit">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Cadastrar dispositivo
          </button>
        </div>
      </div>
    </form>
  </main>
  <script>
    const enableWake = document.querySelector("#enableWake");
    const enableAccess = document.querySelector("#enableAccess");
    const wakeFields = document.querySelector("#wakeFields");
    const accessFields = document.querySelector("#accessFields");
    const accessPort = document.querySelector("#accessPort");

    function setGroupEnabled(group, enabled) {
      group.hidden = !enabled;
      group.querySelectorAll("input").forEach((input) => {
        input.disabled = !enabled;
      });
    }

    function updateWakeFields() {
      setGroupEnabled(wakeFields, enableWake.checked);
    }

    function updateAccessFields() {
      setGroupEnabled(accessFields, enableAccess.checked);
      accessPort.required = enableAccess.checked;
    }

    enableWake.addEventListener("change", updateWakeFields);
    enableAccess.addEventListener("change", updateAccessFields);
    updateWakeFields();
    updateAccessFields();
  </script>
</body>
</html>
