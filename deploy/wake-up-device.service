[Unit]
Description=Wake Up Device web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wake-up-device
Group=wake-up-device
WorkingDirectory=/opt/wake-up-device
EnvironmentFile=/etc/wake-up-device.env
ExecStart=/usr/bin/node /opt/wake-up-device/server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wake-up-device

[Install]
WantedBy=multi-user.target
