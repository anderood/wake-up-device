[Unit]
Description=Wake Up Device EC2 worker tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wake-up-device
Group=wake-up-device
WorkingDirectory=/opt/wake-up-device/worker
EnvironmentFile=/etc/wake-up-device.env
Environment=PYTHONPATH=/opt/wake-up-device/worker/src
ExecStart=/opt/wake-up-device/.venv/bin/python -m ec2_worker.cli --tick
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wake-up-device
